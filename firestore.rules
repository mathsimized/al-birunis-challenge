rules_version = '2';

/* Al-Biruni's Challenge 2026 — Firestore rules.
 *
 * ############################################################################
 * # THIS FILE IS THE WHOLE PROJECT'S RULES, NOT JUST OURS.                #
 * #                                                                        #
 * # Firebase has exactly one security ruleset per project, and this        #
 * # competition shares the MATHSIMIZED project so that a student keeps    #
 * # one login. Deploying this file therefore REPLACES the rules that run   #
 * # the existing MATHSIMIZED site. Everything that site needs is carried   #
 * # over verbatim below, under "MATHSIMIZED — DO NOT REMOVE".             #
 * #                                                                        #
 * # If a rule for a MATHSIMIZED collection is ever dropped from this file, #
 * # that part of the live site breaks: games, news, lectures, notes, the  #
 * # leaderboard, scores, chat, the contact form, presence, password        #
 * # resets, or the public read of `users` that the username-uniqueness     #
 * # check depends on.                                                      #
 * ############################################################################
 *
 * Security model for the competition
 *   public   : published configuration, published announcements, public
 *              result snapshots. Nothing else.
 *   student  : their own registration, attempt, result, Round 2 submission,
 *              certificates. Never the question bank, never the answer keys,
 *              never anybody else's work.
 *   admin    : the competition data. Roles live in abc_users.
 *
 * Judging is not done on this platform, so there is no judge role. The
 * organiser marks finalists and publishes their names.
 *
 * The question bank and answer keys are administrator-only because the paper
 * is scored by the organiser's own session, with no backend to hide behind.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/abc_users/$(request.auth.uid));
    }

    function role() {
      return signedIn() && me().data.role;
    }

    function isAdmin() {
      return role() == 'admin';
    }


    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /* The organiser signs in with this address, and the admin role is granted
       from the verified token rather than from a document that only an
       existing admin could create. Without this the organiser can never
       bootstrap their own admin record, because creating one would need
       admin rights in the first place. */
    function isOrganiser() {
      return signedIn()
        && request.auth.token.email == 'mathsimized@gmail.com';
    }

    function isTimestamp(value) {
      return value is timestamp;
    }

    /* ######################################################################
     * MATHSIMIZED — DO NOT REMOVE
     *
     * The live site's current ruleset, copied in exactly as it stands.
     * Firebase has one ruleset per project and this project is shared, so
     * deploying this file REPLACES these rules. Every line below is load-
     * bearing for the existing website. Keep it in sync with the live file,
     * and run the test suite after any change here.
     * ###################################################################### */

    function isAdminEmail() {
      return request.auth != null
        && request.auth.token.email == "mathsimized@gmail.com";
    }

    match /{document=**} {
      allow read, write: if isAdminEmail();
    }

    // Users - public read so username check works during signup
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public read, admin-only write
    match /games/{document=**} {
      allow read: if true;
      allow write: if isAdminEmail();
    }
    match /news/{document=**} {
      allow read: if true;
      allow write: if isAdminEmail();
    }
    match /lectures/{document=**} {
      allow read: if true;
      allow write: if isAdminEmail();
    }
    match /notes/{document=**} {
      allow read: if true;
      allow write: if isAdminEmail();
    }
    match /announcements/{document=**} {
      allow read: if true;
      allow write: if isAdminEmail();
    }
    match /competitions/{document=**} {
      allow read: if true;
      allow write: if isAdminEmail();
    }
    match /resource_stats/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Scores - any logged in user can write
    match /scores/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Leaderboard - any logged in user can write
    match /leaderboard/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Auth-only collections
    match /chatRooms/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /presence/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /password_resets/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /competition_participants/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /bookmarks/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /continue_learning/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /activity/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /downloads/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /recently_viewed/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /competition_registrations/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /achievements/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdminEmail();
    }
    match /notifications/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdminEmail();
    }
    match /feedback/{document=**} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdminEmail();
    }

    // Contact form - anyone can submit
    match /contact/{document} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Blocked
    match /test_collection/{document=**} {
      allow read, write: if false;
    }

    /* ---------------- configuration ---------------- */
    match /abc_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------------- accounts and roles ---------------- */
    match /abc_users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      /* A student may create their own record and may only ever claim the
         student role. `resource` does not exist on create, so the key set is
         checked instead. */
      allow create: if isSelf(uid)
                    && (isOrganiser()
                          ? request.resource.data.role == 'admin'
                          : request.resource.data.role == 'student')
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'role', 'email', 'displayName', 'username',
                          'createdAt', 'updatedAt', 'lastSeenAt']);
      /* A student can keep their own role but never change it. The organiser
         may promote their own record to admin, and nobody can reach a role
         other than admin through this path. */
      allow update: if isAdmin()
                    || (isSelf(uid)
                        && (request.resource.data.role == resource.data.role
                            || (isOrganiser()
                                && request.resource.data.role == 'admin')));
      allow delete: if isAdmin();
    }

    /* ---------------- registrations ---------------- */
    match /abc_registrations/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
                    && request.resource.data.category in ['prep', 'olevel', 'alevel'];
      /* The student owns their contact details and category. Organiser-only
         fields (qualification, category lock, review) are not writable here. */
      allow update: if isAdmin() || (isSelf(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['qualifiedForRound2', 'qualifiedAt', 'round1Rank',
                               'round2Qualified', 'reviewedAt', 'reviewedBy', 'id']));
      allow delete: if isSelf(uid) || isAdmin();
    }

    /* ---------------- Round 1 question bank and answer keys ---------------- */
    match /abc_questions/{questionId} {
      /* Open to signed-in users so a student can build their own paper, but
         only the answer-free fields, and only while a question is active.
         Administrators may also read retired questions to review the bank. */
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'active');
      allow write: if isAdmin();
    }

    /* The answers, keyed by question id. Administrator-only: a student can
       read the paper and autosave, but can never read a correct answer, and
       scoring runs from the admin panel's own session. */
    match /abc_answer_keys/{questionId} {
      allow read, write: if isAdmin();
    }

    /* Round 1 and Round 2 settings, and the Grand Finale plan, which is stored
       as abc_config/grandFinale rather than a collection of its own. */
    match /abc_quizzes/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------------- attempts ---------------- */
    match /abc_attempts/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();

      /* A student opens their own attempt, so the client writes the questions
         and the paper. What the rules pin down is everything that would let
         that be abused: the category has to be the one they registered for, so
         nobody sits an easier category's paper, and the count has to be the one
         the organiser configured. */
      allow create: if isAdmin()
                    || (isSelf(uid)
                        && request.resource.data.status == 'in-progress'
                        && request.resource.data.score == null
                        && request.resource.data.maxScore == null
                        && request.resource.data.correctCount == null
                        && request.resource.data.breakdown == null
                        && request.resource.data.category
                             == get(/databases/$(database)/documents/abc_registrations/$(uid)).data.category
                        /* exists() guards the lookup: reading .data on a
                           document that does not exist is an error, not null,
                           and an error denies the write. Until Round 1 is
                           configured there is no count to match, so the check
                           is skipped. */
                        && (!exists(/databases/$(database)/documents/abc_quizzes/round1)
                            || request.resource.data.questionCount
                                 == get(/databases/$(database)/documents/abc_quizzes/round1).data.questionCount));

      /* A student's own write may only do one of two things: autosave while the
         paper is open, or hand the attempt in. Once it is submitted the
         document is closed to them, so an answer cannot be changed after the
         timer. Scores, the paper and the server's startedAt are never writable
         by a student at all. */
      allow update: if isAdmin()
                    || (isSelf(uid)
                        && request.resource.data.score == null
                        && request.resource.data.maxScore == null
                        && request.resource.data.correctCount == null
                        && request.resource.data.breakdown == null
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['score', 'maxScore', 'correctCount', 'breakdown',
                                      'scoredAt', 'questions', 'uid', 'startedAt',
                                      'category', 'studentName', 'school', 'city',
                                      'totalMarksAvailable', 'quizSnapshot'])
                        && (request.resource.data.status == 'in-progress'
                            || (resource.data.status == 'in-progress'
                                && request.resource.data.status == 'submitted'
                                && request.resource.data.resultStatus == 'pending-scoring')));
    }

    /* ---------------- results ---------------- */
    match /abc_results/{uid} {
      /* A student sees their own result only once an administrator releases
         it. The raw document is never the public leaderboard. */
      allow read: if isAdmin() || (isSelf(uid) && resource.data.releasedToStudent == true);
      allow write: if isAdmin();
    }

    /* Published, sanitised snapshots for the public leaderboard. */
    match /abc_public_results/{category} {
      allow read: if resource.data.published == true;
      allow write: if isAdmin();
    }

    /* ---------------- Round 2 ----------------
       Students submit a link to their own work. Judging happens off the
       platform, so no one but the student and the organiser ever reads it. */
    match /abc_round2_submissions/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /abc_finalists/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    /* ---------------- judges ---------------- */
    /* ---------------- certificates ---------------- */
    match /abc_certificates/{certificateId} {
      allow read: if isSelf(resource.data.uid) || isAdmin();
      allow write: if isAdmin();
    }

    /* ---------------- Brand Ambassadors ----------------
       Applications arrive on a Google Form and are added by the organiser, so
       there is no student-facing application to read. This collection is
       closed to everyone but an administrator, which is what keeps the
       attributed counts private and stops a student raising their own. */
    match /abc_ba/{code} {
      allow read, write: if isAdmin();
    }

    /* The published top five: names and ranks, written by the organiser. The
       document itself never holds a count. */
    match /abc_public_ba/{doc} {
      allow read: if resource.data.published == true;
      allow write: if isAdmin();
    }

    /* ---------------- announcements ---------------- */
    match /abc_announcements/{announcementId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    /* ---------------- audit log ---------------- */
    match /abc_audit_log/{entryId} {
      allow read, write: if isAdmin();
    }

    /* ---------------- contact and misc ---------------- */
    /* Anything not listed above is closed. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
